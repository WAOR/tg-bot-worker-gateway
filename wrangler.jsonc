{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-bot-worker-gateway",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // [SECURITY] ADMIN_PASSWORD must be set as a Wrangler Secret — never hardcode here.
  // Run once: wrangler secret put ADMIN_PASSWORD
  "vars": {
    "ENABLE_PUBLIC_GATEWAY": "false"
  },
  "kv_namespaces": [
    {
      "binding": "BOT_GATEWAY_KV",
      "id": "YOUR_KV_NAMESPACE_ID_HERE"
    }
  ]
}
