{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-bot-worker-gateway",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ADMIN_PASSWORD": "admin",
    "ENABLE_PUBLIC_GATEWAY": "true"
  },
  "kv_namespaces": [
    {
      "binding": "BOT_GATEWAY_KV",
      "id": "YOUR_KV_NAMESPACE_ID_HERE"
    }
  ]
}
